<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <ImageView
        android:id="@+id/ivPhotoPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:visibility="gone"
        android:background="#000000"/>

    <!-- Вспышка сверху-слева в ландшафте -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="start"
        android:layout_gravity="top">
        <TextView
            android:id="@+id/btnTorch"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:gravity="center"
            android:text="⚡"
            android:textSize="32sp"
            android:textColor="#FFFFFF"
            android:background="?attr/selectableItemBackgroundBorderless"/>
    </LinearLayout>

    <!-- Панель съемки: кнопка СПРАВА ПО ЦЕНТРУ (ландшафт) -->
    <LinearLayout
        android:id="@+id/layoutCapture"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical|end"
        android:padding="24dp">

        <TextView
            android:id="@+id/btnCancel"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:gravity="center"
            android:text="✕"
            android:textSize="28sp"
            android:textColor="#FFFFFF"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_marginEnd="40dp"/>

        <ImageButton
            android:id="@+id/btnCapture"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@drawable/btn_capture_bg"
            android:layout_marginEnd="24dp"/>

        <View
            android:layout_width="56dp"
            android:layout_height="56dp"/>
    </LinearLayout>

    <!-- Панель предпросмотра (вертикальная справа в ландшафте) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutPreview"
        android:layout_width="120dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/btnRetake"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@drawable/btn_capture_bg"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRotate"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:text="↻"
            android:textSize="28sp"
            android:textColor="#FFFFFF"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:backgroundTint="#3A3A3C"
            app:cornerRadius="12dp"
            android:padding="0dp"
            app:layout_constraintBottom_toTopOf="@+id/btnRetake"
            app:layout_constraintStart_toStartOf="@+id/btnRetake"
            app:layout_constraintEnd_toEndOf="@+id/btnRetake"
            android:layout_marginBottom="48dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirm"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:text="✓"
            android:textSize="28sp"
            android:textColor="#FFFFFF"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:backgroundTint="#00695c"
            app:cornerRadius="12dp"
            android:padding="0dp"
            app:layout_constraintTop_toBottomOf="@+id/btnRetake"
            app:layout_constraintStart_toStartOf="@+id/btnRetake"
            app:layout_constraintEnd_toEndOf="@+id/btnRetake"
            android:layout_marginTop="48dp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>