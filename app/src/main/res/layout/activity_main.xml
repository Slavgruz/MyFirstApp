<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F7"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="АДРЕС"
            android:textSize="12sp"
            android:textColor="#8E8E93"
            android:textStyle="bold"
            android:paddingHorizontal="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="8dp"/>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">

                <EditText
                    android:id="@+id/etStreet"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:hint="Улица"
                    android:textSize="18sp"
                    android:inputType="text"
                    android:background="@android:color/transparent"
                    android:minHeight="48dp"
                    android:layout_marginEnd="12dp"/>

                <View android:layout_width="1dp" android:layout_height="24dp" android:background="#E0E0E0"/>

                <EditText
                    android:id="@+id/etHouse"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:hint="Дом"
                    android:textSize="18sp"
                    android:inputType="number"
                    android:background="@android:color/transparent"
                    android:minHeight="48dp"
                    android:minWidth="56dp"
                    android:gravity="center"
                    android:layout_marginHorizontal="4dp"/>

                <View android:layout_width="1dp" android:layout_height="24dp" android:background="#E0E0E0"/>

                <EditText
                    android:id="@+id/etBuilding"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:hint="Кор"
                    android:textSize="18sp"
                    android:inputType="text"
                    android:background="@android:color/transparent"
                    android:minHeight="48dp"
                    android:minWidth="56dp"
                    android:gravity="center"
                    android:layout_marginHorizontal="4dp"/>

                <View android:layout_width="1dp" android:layout_height="24dp" android:background="#E0E0E0"/>

                <EditText
                    android:id="@+id/etApartment"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:hint="Кв"
                    android:textSize="18sp"
                    android:inputType="number"
                    android:background="@android:color/transparent"
                    android:minHeight="48dp"
                    android:minWidth="56dp"
                    android:gravity="center"
                    android:layout_marginStart="4dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="РЕСУРС"
            android:textSize="12sp"
            android:textColor="#8E8E93"
            android:textStyle="bold"
            android:paddingHorizontal="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="8dp"/>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp">

            <RadioGroup
                android:id="@+id/rgResource"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="8dp">

                <RadioButton
                    android:id="@+id/rbHvs"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="ХВС"
                    android:textSize="16sp"
                    android:button="@null"
                    android:gravity="center"
                    android:padding="14dp"
                    android:checked="true"/>

                <RadioButton
                    android:id="@+id/rbGvs"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="ГВС"
                    android:textSize="16sp"
                    android:button="@null"
                    android:gravity="center"
                    android:padding="14dp"/>

                <RadioButton
                    android:id="@+id/rbHeat"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Тепло"
                    android:textSize="16sp"
                    android:button="@null"
                    android:gravity="center"
                    android:padding="14dp"/>
            </RadioGroup>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ПОКАЗАНИЯ"
            android:textSize="12sp"
            android:textColor="#8E8E93"
            android:textStyle="bold"
            android:paddingHorizontal="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="8dp"/>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="8dp"
                android:gravity="center">

                <com.example.myfirstapp.WheelView android:id="@+id/wheel1" android:layout_width="0dp" android:layout_height="180dp" android:layout_weight="1"/>
                <com.example.myfirstapp.WheelView android:id="@+id/wheel2" android:layout_width="0dp" android:layout_height="180dp" android:layout_weight="1"/>
                <com.example.myfirstapp.WheelView android:id="@+id/wheel3" android:layout_width="0dp" android:layout_height="180dp" android:layout_weight="1"/>
                <com.example.myfirstapp.WheelView android:id="@+id/wheel4" android:layout_width="0dp" android:layout_height="180dp" android:layout_weight="1"/>
                <com.example.myfirstapp.WheelView android:id="@+id/wheel5" android:layout_width="0dp" android:layout_height="180dp" android:layout_weight="1"/>
                <com.example.myfirstapp.WheelView android:id="@+id/wheel6" android:layout_width="0dp" android:layout_height="180dp" android:layout_weight="1"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="180dp"
                    android:gravity="center"
                    android:text="."
                    android:textSize="48sp"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    android:paddingHorizontal="4dp"/>

                <com.example.myfirstapp.WheelView android:id="@+id/wheel7" android:layout_width="0dp" android:layout_height="180dp" android:layout_weight="1"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Карточка OCR-шпаргалки -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardOcrResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeWidth="1dp"
            app:strokeColor="#00695c">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="РАСПОЗНАНО (ЦЕЛАЯ ЧАСТЬ)"
                    android:textSize="12sp"
                    android:textColor="#8E8E93"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/tvOcrResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:textColor="#00695c"
                    android:gravity="center"
                    android:fontFamily="monospace"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Используйте как подсказку. Дробную часть (красные цифры) докрутите вручную при необходимости."
                    android:textSize="12sp"
                    android:textColor="#8E8E93"
                    android:gravity="center"
                    android:layout_marginTop="8dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCamera"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="32dp"
            android:text="📷 Сделать фото"
            android:textSize="18sp"
            android:textColor="#1C1C1E"
            app:cornerRadius="12dp"
            app:strokeColor="#1C1C1E"
            app:strokeWidth="1dp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="12dp"
            android:text="✅ Сохранить"
            android:textSize="18sp"
            app:cornerRadius="12dp"
            app:backgroundTint="#00695c"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnJournal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="24dp"
            android:text="📋 Журнал обходов"
            android:textSize="16sp"
            android:textColor="#8E8E93"
            android:backgroundTint="@android:color/transparent"
            app:cornerRadius="12dp"
            app:strokeColor="#E0E0E0"
            app:strokeWidth="1dp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
    </LinearLayout>
</ScrollView>